{
  "manifest_version": 3,
  "name": "Chatty for Twitch",
  "version": "0.6.7",
  "description": "A compact Chatterino-inspired Twitch chat with 7TV emotes and custom highlights.",
  "icons": {
    "16": "assets/icons/chatty-16.png",
    "32": "assets/icons/chatty-32.png",
    "48": "assets/icons/chatty-48.png",
    "128": "assets/icons/chatty-128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://7tv.io/*",
    "https://decapi.me/*",
    "https://www.twitch.tv/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/twitch.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/chatty-32.png"],
      "matches": ["https://www.twitch.tv/*"]
    }
  ],
  "action": {
    "default_title": "Chatty for Twitch",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icons/chatty-16.png",
      "32": "assets/icons/chatty-32.png",
      "48": "assets/icons/chatty-48.png",
      "128": "assets/icons/chatty-128.png"
    }
  }
}
